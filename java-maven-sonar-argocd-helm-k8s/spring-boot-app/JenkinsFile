pipeline {
  agent {
    docker {
      image 'arslanzafar18/maven-abhishek-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock'
    }
  }

  stages {
    stage('Checkout') {
      steps {
        dir('workspace') {
          git branch: 'feature', url: 'https://github.com/arslanzafar18/Jenkins-Zero-To-Hero.git'
        }
      }
    }

    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        sh 'cd workspace/java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn clean package'
      }
    }

    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://13.60.172.175:9000"
      }
      steps {
        withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
          sh 'cd workspace/java-maven-sonar-argocd-helm-k8s/spring-boot-app && mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "arslanzafar18/maven-abhishek-docker-agent:${BUILD_NUMBER}"
      }
      steps {
        script {
          sh 'cd workspace/java-maven-sonar-argocd-helm-k8s/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
          def dockerImage = docker.image("${DOCKER_IMAGE}")
          docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
            dockerImage.push()
          }
        }
      }
    }

stage('Update Deployment File') {
  steps {
    withEnv(["PATH+EXTRA=/usr/bin"]) {
      dir('workspace') {   // ✅ root of the git repo
        withCredentials([string(credentialsId: 'github-token', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "arslan.zfr18@gmail.com"
            git config user.name "Jenkins CI"
            git checkout feature || git checkout -b feature
            git pull origin feature
            sed -i "s|image:.*|image: arslanzafar18/maven-abhishek-docker-agent:${BUILD_NUMBER}|g" java-maven-sonar-argocd-helm-k8s/helm/values.yaml
            git add java-maven-sonar-argocd-helm-k8s/helm/values.yaml
            git commit -m "Updated image tag to ${BUILD_NUMBER} [ci skip]" || echo "No changes to commit"
            git push https://$GITHUB_TOKEN@github.com/arslanzafar18/Jenkins-Zero-To-Hero.git feature
          '''
        }
      }
    }
  }
}

  }
}
